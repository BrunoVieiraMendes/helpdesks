MONGO_URL='mongodb://127.0.0.1:27017/helpdesk'
NODE_ENV='development'
LOG_LEVEL='debug'
PORTA=3000
JWT_SECRET_KEY='troque-este-segredo'
JWT_EXPIRA_EM='8h'
REDIS_URL='redis://127.0.0.1:6379'
EMAIL_HOST='localhost'
EMAIL_PORT=1025
EMAIL_REMETENTE='Help Desk <suporte@helpdesk.local>'
# As contas de e-mail (SMTP/IMAP) podem ser configuradas pela tela: Configurações > E-mail.
# As variáveis EMAIL_* acima só valem enquanto o envio não estiver ativado lá.
# Chave usada para cifrar as senhas das contas de e-mail no banco (texto longo e secreto).
CHAVE_CRIPTOGRAFIA='troque-por-um-texto-longo-e-aleatorio'
# LEITURA_DE_EMAIL=false desliga a leitura automática da caixa de entrada
URL_DO_HELPDESK='http://localhost:3000'
# dias que um chamado fica em "Resolvido" antes de ser fechado automaticamente
DIAS_PARA_FECHAMENTO_AUTOMATICO=3
