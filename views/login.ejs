<%- include('partials/head') %>
<main class="tela-login">
  <section class="lado-marca">
    <div class="marca-login<%= marca.logo ? ' com-imagem' : '' %>"><% if (marca.logo) { %><img class="imagem-logo" src="<%= marca.logo %>" alt="<%= marca.nome %>" /><% } else { %><span class="logo">HD</span><% } %> <%= marca.nome %></div>
    <div class="chamada-login">
      <h1>Atendimento organizado, cliente satisfeito.</h1>
      <p>Chamados, prazos de SLA e indicadores da sua equipe em um só lugar.</p>
      <ul class="beneficios">
        <li>Fila por equipe com prazos contados em horário útil</li>
        <li>Portal simples para o cliente abrir e acompanhar chamados</li>
        <li>Indicadores e relatórios prontos para exportar</li>
      </ul>
    </div>
    <p class="rodape-marca"><%= marca.nome %> · Central de atendimento</p>
  </section>

  <section class="lado-formulario">
    <div class="cartao-login">
      <div class="marca-login compacta<%= marca.logo ? ' com-imagem' : '' %>"><% if (marca.logo) { %><img class="imagem-logo" src="<%= marca.logo %>" alt="<%= marca.nome %>" /><% } else { %><span class="logo">HD</span><% } %> <%= marca.nome %></div>
      <h2>Entrar na sua conta</h2>
      <p class="subtitulo-login">Use seu e-mail e senha para acessar.</p>
      <div id="aviso"></div>
      <form id="form-login" novalidate>
        <div class="campo">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" autocomplete="username" placeholder="voce@empresa.com" required autofocus />
        </div>
        <div class="campo">
          <label for="senha">Senha</label>
          <input id="senha" name="senha" type="password" autocomplete="current-password" placeholder="Sua senha" required />
        </div>
        <button class="botao primario bloco grande" type="submit" id="botao-entrar">Entrar</button>
      </form>
      <div class="contas-teste">
        <p>Contas de teste <span>(senha <code>helpdesk123</code>)</span></p>
        <div class="lista-contas">
          <button type="button" data-email="admin@helpdesk.com"><strong>Admin</strong><span>admin@helpdesk.com</span></button>
          <button type="button" data-email="ana@helpdesk.com"><strong>Agente</strong><span>ana@helpdesk.com</span></button>
          <button type="button" data-email="carlos@helpdesk.com"><strong>Agente</strong><span>carlos@helpdesk.com</span></button>
          <button type="button" data-email="joao@cliente.com"><strong>Cliente</strong><span>joao@cliente.com</span></button>
          <button type="button" data-email="maria@cliente.com"><strong>Cliente</strong><span>maria@cliente.com</span></button>
        </div>
      </div>
    </div>
  </section>
</main>
<script src="/static/js/login.js"></script>
<%- include('partials/fim') %>
