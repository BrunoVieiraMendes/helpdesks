<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="pagina larga pagina-config">
  <div class="painel-config">
  <div class="painel-principal">
    <div class="busca-config">
      <label class="campo-busca">
        <span class="sr-only">Buscar configuração</span>
        <input type="search" id="busca-config" placeholder="Do que você precisa?" autocomplete="off" />
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </label>
      <div class="alterna-modo" role="group" aria-label="Organizar por">
        <button type="button" data-modo="grupo" aria-pressed="true">Grupo</button>
        <button type="button" data-modo="az" aria-pressed="false">A - Z</button>
      </div>
    </div>
    <div id="itens-config"></div>
  </div>

  <aside class="painel-lateral">
    <section class="cartao quadro-lateral" id="quadro-pessoas">
      <h2><span class="icone-titulo" data-icone="pessoas"></span>Pessoas</h2>
      <div class="corpo-quadro"><div class="esqueleto" style="width: 60%"></div></div>
    </section>
    <section class="cartao quadro-lateral" id="quadro-fila">
      <h2><span class="icone-titulo" data-icone="acordos"></span>Situação do atendimento</h2>
      <div class="corpo-quadro"><div class="esqueleto" style="width: 60%"></div></div>
    </section>
  </aside>
  </div>
</main>
<script src="/static/js/icones.js"></script>
<script src="/static/js/admin-painel.js"></script>
<%- include('../partials/fim') %>
