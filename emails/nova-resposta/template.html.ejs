<div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;color:#1f2937">
  <h2 style="color:#2563eb">Nova resposta no chamado #<%= chamado.numero %></h2>
  <p>Olá, <%= destinatario.nome %>!</p>
  <p><strong><%= interacao.autor.nome %></strong> respondeu o chamado <strong><%= chamado.titulo %></strong>:</p>
  <blockquote style="border-left:3px solid #2563eb;margin:0;padding:8px 12px;background:#f3f4f6;white-space:pre-wrap"><%= interacao.mensagem %></blockquote>
  <p><a href="<%= urlDoHelpdesk %>/chamados/<%= chamado.numero %>" style="background:#2563eb;color:#fff;padding:10px 16px;border-radius:6px;text-decoration:none">Ver chamado</a></p>
</div>
