<div style="font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:auto;color:#1f2430;line-height:1.5">
  <% if (podeResponder) { %><div style="color:#9ca3af;font-size:12px;margin-bottom:12px"><%= marcador %></div><% } %>
  <div style="border-top:4px solid #f97316;padding:20px 24px;background:#ffffff">
    <h2 style="margin:0 0 12px;color:#c2410c">Nova resposta no chamado #<%= chamado.numero %></h2>
    <p>Olá, <%= destinatario.nome %>!</p>
    <p><strong><%= interacao.autor ? interacao.autor.nome : 'A equipe' %></strong> respondeu o chamado <strong><%= chamado.titulo %></strong>:</p>
    <div style="border-left:3px solid #f97316;margin:0 0 16px;padding:10px 14px;background:#fff7ed;white-space:pre-wrap"><%= interacao.mensagem %></div>
    <p><a href="<%= urlDoHelpdesk %>/chamados/<%= chamado.numero %>" style="background:#c2410c;color:#fff;padding:11px 18px;border-radius:8px;text-decoration:none;font-weight:600;display:inline-block">Ver chamado</a></p>
    <% if (podeResponder) { %><p style="color:#6b7280;font-size:12px;margin-top:20px">Você pode responder este e-mail diretamente: sua mensagem entra no chamado.</p><% } %>
  </div>
</div>
